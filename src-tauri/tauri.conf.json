{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Etiket Hazırlayıcı",
  "version": "26.6.0",
  "identifier": "com.ekomak.etiket-hazırlayici",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Etiket Hazırlayıcı",
        "width": 1280,
        "height": 750,
        "minWidth": 1100,
        "minHeight": 650,
