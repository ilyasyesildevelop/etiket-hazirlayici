    "shortDescription": "Etiket Hazırlayıcı",
    "longDescription": "Etiket Hazırlayıcı - Developed by İlyas Yeşil for Green Labs Development Technology, Inc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
